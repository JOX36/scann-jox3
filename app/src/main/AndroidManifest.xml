<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Requerido para poder abrir la pantalla estándar de instalación de un
        .apk descargado por la propia app (actualizaciones automáticas).
        El usuario sigue confirmando la instalación manualmente; este
        permiso solo habilita que Android le muestre esa pantalla cuando
        viene de un instalador que no es Google Play.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="IPTV Scanner"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:replace="android:allowBackup,android:label"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic: los paneles Xtream casi siempre se sirven
            por "http://" sin TLS (nunca "https://"). Desde Android 9
            (API 28) el sistema bloquea TODO tráfico sin cifrar por
            defecto, así que sin esto cada verificación de lista fallaba
            antes de salir del teléfono y volvía como "Inactiva" aunque el
            panel sí funcionara — el motivo real de que un escaneo marcara
            el 100% de las listas encontradas como inactivas.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Expone el .apk descargado al instalador del sistema. Ver
            res/xml/file_paths.xml para la carpeta compartida.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Recibe el aviso del sistema cuando termina la descarga del .apk. -->
        <receiver
            android:name="com.jox3.scanner.update.UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
